+
+/* ---------------------------------------------------------------------------
+   The product page
+
+   The shop's own type and ground: Tenor Sans for everything, near-black ink on
+   white, and a lot of air around it. The palette is deliberately one colour
+   plus a rule grey, so nothing has to be read from a hue.
+   --------------------------------------------------------------------------- */
+
+:root {
+  --page-ground: #ffffff;
+  --page-soft: #f6f5f2;
+  --page-ink: #111111;
+  --page-muted: #5c5a55;
+  --page-rule: #e6e4df;
+  --font-display: "Tenor Sans", ui-serif, Georgia, "Times New Roman", serif;
+}
+
+.visually-hidden {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  margin: -1px;
+  padding: 0;
+  border: 0;
+  clip: rect(0 0 0 0);
+  clip-path: inset(50%);
+  overflow: hidden;
+  white-space: nowrap;
+}
+
+.site-header {
+  position: relative;
+  z-index: 2;
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: clamp(1rem, 4vw, 3rem);
+  padding: clamp(0.9rem, 2.2vw, 1.6rem) clamp(1.25rem, 5vw, 4rem);
+  background: var(--page-ground);
+  color: var(--page-ink);
+  border-bottom: 1px solid var(--page-rule);
+}
+
+.site-header__brand img {
+  display: block;
+  width: auto;
+  height: clamp(34px, 4vw, 46px);
+}
+
+.site-header__nav ul {
+  display: flex;
+  flex-wrap: wrap;
+  gap: clamp(0.9rem, 2.6vw, 2.25rem);
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.site-header__nav a {
+  display: inline-block;
+  padding: 0.35rem 0;
+  font-family: var(--font-display);
+  font-size: 0.8rem;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+  color: inherit;
+  text-decoration: none;
+  border-bottom: 1px solid transparent;
+}
+
+.site-header__nav a:hover,
+.site-header__nav a:focus-visible {
+  border-bottom-color: currentColor;
+}
+
+.site-header__nav a:focus-visible,
+.site-footer a:focus-visible {
+  outline: 2px solid var(--page-ink);
+  outline-offset: 3px;
+}
+
+.product {
+  position: relative;
+  z-index: 2;
+  background: var(--page-ground);
+  color: var(--page-ink);
+  font-family: var(--font-display);
+  letter-spacing: 0.02em;
+}
+
+.product h1,
+.product h2,
+.product h3 {
+  margin: 0;
+  font-family: var(--font-display);
+  font-weight: 400;
+  letter-spacing: 0.06em;
+  line-height: 1.12;
+  text-transform: uppercase;
+}
+
+.product__intro {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
+  gap: clamp(1.75rem, 5vw, 5rem);
+  align-items: start;
+  max-width: 1240px;
+  margin: 0 auto;
+  padding: clamp(2.5rem, 7vw, 5.5rem) clamp(1.25rem, 5vw, 4rem) clamp(2rem, 5vw, 4rem);
+}
+
+/* --- gallery ------------------------------------------------------------- */
+
+.gallery__stage {
+  margin: 0;
+  background: var(--page-soft);
+  overflow: hidden;
+}
+
+.gallery__image {
+  display: block;
+  width: 100%;
+  height: auto;
+}
+
+.gallery__thumbs {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 0.6rem;
+  margin: 0.75rem 0 0;
+  padding: 0;
+  list-style: none;
+}
+
+.gallery__thumb {
+  display: block;
+  width: 100%;
+  padding: 0.3rem;
+  background: var(--page-ground);
+  border: 1px solid var(--page-rule);
+  cursor: pointer;
+}
+
+.gallery__thumb img {
+  display: block;
+  width: 100%;
+  height: auto;
+}
+
+.gallery__thumb:hover {
+  border-color: var(--page-ink);
+}
+
+/* Selected by weight and by aria-pressed, never by colour alone. */
+.gallery__thumb[aria-pressed="true"] {
+  border: 2px solid var(--page-ink);
+  padding: calc(0.3rem - 1px);
+}
+
+.gallery__thumb:focus-visible {
+  outline: 2px solid var(--page-ink);
+  outline-offset: 2px;
+}
+
+/* --- buy ----------------------------------------------------------------- */
+
+.buy {
+  display: flex;
+  flex-direction: column;
+  gap: 1.15rem;
+}
+
+.buy__title {
+  font-size: clamp(1.7rem, 3.2vw, 2.5rem);
+}
+
+.buy__price {
+  display: flex;
+  align-items: baseline;
+  gap: 0.85rem;
+  margin: 0;
+}
+
+.buy__price-label {
+  font-size: 0.76rem;
+  letter-spacing: 0.18em;
+  text-transform: uppercase;
+  color: var(--page-muted);
+}
+
+.buy__price-amount {
+  font-size: clamp(1.15rem, 1.9vw, 1.5rem);
+  letter-spacing: 0.04em;
+}
+
+.buy__variants {
+  margin: 0;
+  padding: 0;
+  border: 0;
+}
+
+.buy__variants legend {
+  padding: 0 0 0.65rem;
+  font-size: 0.76rem;
+  letter-spacing: 0.18em;
+  text-transform: uppercase;
+  color: var(--page-muted);
+}
+
+.buy__variant {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.5rem;
+  margin: 0 0.6rem 0.6rem 0;
+  padding: 0.55rem 1.05rem;
+  border: 1px solid var(--page-rule);
+  font-size: 0.88rem;
+  letter-spacing: 0.08em;
+  cursor: pointer;
+}
+
+.buy__variant:hover {
+  border-color: var(--page-ink);
+}
+
+.buy__variant input {
+  margin: 0;
+  accent-color: var(--page-ink);
+}
+
+.buy__variant input:focus-visible {
+  outline: 2px solid var(--page-ink);
+  outline-offset: 3px;
+}
+
+.buy__variant-size {
+  letter-spacing: 0.08em;
+}
+
+.buy__variant-price {
+  font-size: 0.8rem;
+  letter-spacing: 0.06em;
+  color: var(--page-muted);
+}
+
+.buy__status {
+  margin: 0;
+  font-size: 0.8rem;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+}
+
+.buy__points {
+  display: flex;
+  flex-direction: column;
+  gap: 0.4rem;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+  font-size: 0.84rem;
+  color: var(--page-muted);
+}
+
+.buy__points li::before {
+  content: "— ";
+}
+
+.buy__add {
+  align-self: flex-start;
+  width: min(340px, 100%);
+  padding: 1rem 2.4rem;
+  font-family: var(--font-display);
+  font-size: 0.82rem;
+  letter-spacing: 0.2em;
+  text-transform: uppercase;
+  color: var(--page-ground);
+  background: var(--page-ink);
+  border: 1px solid var(--page-ink);
+  cursor: pointer;
+}
+
+.buy__add:hover {
+  background: #000000;
+}
+
+.buy__add:focus-visible {
+  outline: 2px solid var(--page-ink);
+  outline-offset: 3px;
+}
+
+.buy__confirm {
+  min-height: 1.2em;
+  margin: 0;
+  font-size: 0.8rem;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+  color: var(--page-muted);
+}
+
+/* --- notes and narrative ------------------------------------------------- */
+
+.notes,
+.narrative {
+  max-width: 1240px;
+  margin: 0 auto;
+  padding: clamp(2.5rem, 6vw, 5rem) clamp(1.25rem, 5vw, 4rem);
+  border-top: 1px solid var(--page-rule);
+}
+
+.notes__heading,
+.narrative__heading {
+  font-size: clamp(1.05rem, 1.7vw, 1.35rem);
+  margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
+}
+
+.narrative__heading {
+  margin-bottom: clamp(1.25rem, 2.5vw, 2rem);
+}
+
+.notes__ingredients {
+  max-width: 72ch;
+  margin-bottom: clamp(2.5rem, 4vw, 3.5rem);
+  font-size: 0.95rem;
+  line-height: 1.8;
+}
+
+.notes__ingredients p {
+  margin: 0 0 1rem;
+}
+
+.notes__ingredients .notes__heading {
+  margin-bottom: 1.1rem;
+}
+
+.notes__grid {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: clamp(1.75rem, 4vw, 3.5rem);
+}
+
+.notes__item h3 {
+  margin-bottom: 0.85rem;
+  font-size: 0.78rem;
+  letter-spacing: 0.2em;
+  color: var(--page-muted);
+}
+
+.notes__value {
+  margin: 0 0 0.7rem;
+  font-size: 1rem;
+  letter-spacing: 0.06em;
+  line-height: 1.5;
+}
+
+.notes__description {
+  margin: 0;
+  font-size: 0.9rem;
+  line-height: 1.8;
+  color: var(--page-muted);
+}
+
+.narrative__body {
+  max-width: 68ch;
+  font-size: 1rem;
+  line-height: 1.9;
+}
+
+.narrative__body p {
+  margin: 0 0 1.35rem;
+}
+
+.narrative__body em {
+  color: var(--page-muted);
+}
+
+/* --- footer -------------------------------------------------------------- */
+
+.site-footer {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 1.5rem;
+  padding: clamp(2rem, 5vw, 3.5rem) clamp(1.25rem, 5vw, 4rem);
+  background: var(--page-soft);
+  color: var(--page-ink);
+  border-top: 1px solid var(--page-rule);
+  font-family: var(--font-display);
+}
+
+.site-footer__logo {
+  display: block;
+  width: auto;
+  height: clamp(30px, 3.4vw, 40px);
+}
+
+.site-footer__note {
+  margin: 0;
+  font-size: 0.75rem;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+  color: var(--page-muted);
+}
+
+.site-footer__payments {
+  display: block;
+  width: auto;
+  height: clamp(22px, 2.6vw, 30px);
+}
+
+@media (max-width: 820px) {
+  .product__intro {
+    grid-template-columns: minmax(0, 1fr);
+  }
+
+  .notes__grid {
+    grid-template-columns: minmax(0, 1fr);
+  }
+
+  .buy__add {
+    align-self: stretch;
+  }
+}
